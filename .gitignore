# =============================================================================
# Root .gitignore — Glitch HR Intelligence System
# =============================================================================

# Environment variables & secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example

# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/

# Testing & code coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Node.js & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
next-env.d.ts

# Disaster Recovery & Backups (CRITICAL: Keep encrypted backups out of Git)
backend/dr_backups/
dr_backups/
*.enc
*.backup
*.dump
*.tar.gz

# Temporary upload directories & test scratchpads
test_uploads_tmp/
backend/test_uploads_tmp/
uploads/
backend/uploads/
*.tmp
*.log
load_test_results.json

# IDE & OS specific files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini
