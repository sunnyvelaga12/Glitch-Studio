# Glitch HR AI Platform backend environment variables
AI_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL_NAME=gemini-2.0-flash

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005
COMPANY_NAME=Glitch Organization
HR_EMAIL=hr@glitchhr.ai
HR_PHONE=+1-800-555-GLITCH
HRMS_PORTAL=https://hrms.glitchhr.ai

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/hrbot?retryWrites=true&w=majority
# Or separated credentials:
# MONGO_USER=<username>
# MONGO_PASSWORD=<password>
# MONGO_HOST=<cluster-host>
# MONGO_DB=hrbot

# Redis Distributed Caching & Rate Limiting
# REDIS_URL=redis://localhost:6379/0

# JWT & Session Security
JWT_SECRET=replace-with-a-secure-random-secret
JWT_EXP_MINUTES=1440
COOKIE_SECURE=False

# Pinecone Serverless Vector Database (Multi-Tenant RAG)
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=hrbot-policies-employees
PINECONE_DIMENSION=1024
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# Deployment Environment
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
